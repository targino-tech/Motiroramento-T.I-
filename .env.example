# ==============================================================================
# 🌾 NOC Master 360° & Telemetria IT v2.0
# Arquivo de Variáveis de Ambiente (.env) - Exemplo / Template
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha as credenciais e parâmetros conforme seu ambiente.
# 3. NUNCA faça commit do arquivo .env real no GitHub (ele está no .gitignore).
# ==============================================================================

# Fuso Horário
TZ=America/Cuiaba

# Banco de Dados PostgreSQL (Persistência Zabbix)
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=altere_para_uma_senha_forte_postgres
POSTGRES_DB=zabbix

# Administrador Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=altere_para_uma_senha_forte_grafana

# Usuário de Visualização Mobile (Viewer - Perfil Seguro para Celular)
MOBILE_VIEWER_USER=noc.mobile
MOBILE_VIEWER_PASSWORD=altere_para_uma_senha_segura_mobile

# Integração Telegram (Alertas e Bot Interativo)
# Obtenha com @BotFather no Telegram
TELEGRAM_BOT_TOKEN=SEU_TOKEN_TELEGRAM_AQUI
# Seu Chat ID ou ID do Grupo (obtenha via @userinfobot)
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI

# Telemetria de Rede e Borda
# IP público oficial ou de demonstração (RFC 5737: 203.0.113.1)
PUBLIC_WAN_IP=203.0.113.1
# IP do Servidor Zabbix na rede interna
ZABBIX_SERVER_IP=10.0.0.10
