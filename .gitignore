# ==============================================================================
# Git Ignore - NOC Master 360°
# ==============================================================================

# Credenciais e Variáveis de Ambiente Sensíveis
.env
.env.local
.env.*.local

# Chaves Criptográficas e Certificados SSL/TLS Privados
*.key
*.pem
*.pfx
*.p12
nginx/ssl/*.key
nginx/ssl/*.crt
!nginx/ssl/.gitkeep

# Arquivos e Tokens de Sessão Temporários / Dinâmicos
MOBILE_ACCESS_URL.txt
mobile_grafana_qr.png
scripts/telegram_preferences.json
!scripts/telegram_preferences.json.example

# Python Caches e Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Logs e Dados Operacionais
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
